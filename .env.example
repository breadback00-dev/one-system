# Database (Neon in production, local Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/one_system?schema=public

# Clerk auth — get from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Demo workspace — ID that seed:demo creates (keep default unless you change seed-demo.ts)
DEMO_WORKSPACE_ID=workspace_medspa_demo

# App
APP_BASE_URL=http://localhost:4000
BOOKING_HANDOFF_URL=https://booking.example.com/consultation
MESSAGE_PROVIDER=dev-log
ONE_SYSTEM_API_KEY=

# Set to "true" on Vercel so unauthenticated demo users can submit forms
# Leave blank in production workspaces that require auth
ALLOW_UNAUTHENTICATED_DASHBOARD_ACTIONS=true
SENSITIVE_DATA_RETENTION_DAYS=180
SENSITIVE_DATA_RETENTION_SWEEP_MS=86400000
OUTBOUND_DELIVERY_CLAIM_TIMEOUT_MS=900000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
